# ---- Admin login for the web UI (not related to Gemini/ChatGPT/Google logins) ----
ADMIN_USERNAME=your-username
# bcrypt hash of your password. Generate with the command in README.md.
# In .env.local wrap it in single quotes so the $ signs are not expanded.
ADMIN_PASSWORD_HASH='$2b$12$replace-with-your-hash'
# Random string, 32+ chars:  openssl rand -base64 48
AUTH_SECRET=replace-with-random-string-of-32-plus-chars

# ---- Storage ----
# Neon Postgres connection string (Vercel Marketplace -> Neon). Tables are created automatically.
DATABASE_URL=postgres://user:password@host/db?sslmode=require
# Added automatically when you connect a Blob store to the project. Only needed for local dev.
BLOB_READ_WRITE_TOKEN=

# ---- Cookie encryption ----
# Cookies are saved from the web UI (Settings page), NOT here. Encrypted before storage.
# openssl rand -base64 32
COOKIE_ENCRYPTION_KEY=

# ---- Mode ----
# mock = fake content, nothing sent anywhere. live = real servers.
PROVIDER_MODE=mock

# ---- Image generation ----
# gemini (default) or chatgpt. ChatGPT is paused while images come from Gemini.
IMAGE_PROVIDER=gemini

# ---- MCP servers ----
# Paste the URL with its key exactly as given. The app encodes special characters in the key.
INSTAGRAM_MCP_URL=https://instagram-mcp-api.vercel.app/mcp?auth=YOUR_KEY
GEMINI_MCP_URL=https://webapi-gray.vercel.app/mcp?key=YOUR_GEMINI_KEY
CHATGPT_MCP_URL=

# Optional. Only if a tool is matched wrongly. JSON, operation -> exact tool name.
# Gemini operations: startResearch, pollResearch, analyze, caption, verifyImage, generateImage
# For the Gemini archive server (webapi), use exactly this value:
# {"startResearch":"gemini_start_deep_research","pollResearch":"gemini_research_status","analyze":"gemini_ask","caption":"gemini_ask","verifyImage":"gemini_analyze_image","generateImage":"gemini_generate_image"}
# ChatGPT operations: generateImage
GEMINI_TOOL_MAP=
CHATGPT_TOOL_MAP=

# HTTP bridges (alternative to the MCP URLs; MCP wins if both are set). Not needed for the current setup.
GEMINI_BRIDGE_URL=
CHATGPT_BRIDGE_URL=

# Public https URL of this app. Instagram downloads the approved image from here.
PUBLIC_APP_URL=https://your-app.vercel.app

# ---- Background driver ----
# Secret for the scheduled workflow (.github/workflows/tick.yml) that runs the next step every 5 minutes.
# At least 16 characters. Also set it as the CRON_SECRET repository secret, with APP_URL as the other one.
# openssl rand -base64 32
CRON_SECRET=
